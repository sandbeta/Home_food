classDiagram
  %% ===== 数据/语义层（逻辑不变，仅视觉消费） =====
  class CartContext {
    +whoAmI: 'me' | 'partner'
    +items: Item[]
    +split: {me:number, partner:number}
    +setWhoAmI()
    +addItem(dish)
  }
  class Item {
    +dish_id: number
    +name: string
    +price: number
    +quantity: number
    +added_by: 'me' | 'partner'
  }
  CartContext "1" *-- "many" Item

  %% ===== 双人格 / 状态 单一真源（src/theme/persona.js） =====
  class PERSONA {
    +me: PersonaEntry
    +partner: PersonaEntry
  }
  class PersonaEntry {
    +key: string
    +label: string
    +emoji: string
    +color: string
    +colorSoft: string
    +gradient: string
    +glassBorder: string
    +glow: string
  }
  class ORDER_STATUS {
    +pending: StatusEntry
    +preparing: StatusEntry
    +completed: StatusEntry
  }
  class StatusEntry {
    +text: string
    +emoji: string
    +ring: [string, string]
    +chipBg: string
    +chipColor: string
  }
  class PAYER {
    +aa: PayerEntry
    +me: PayerEntry
    +partner: PayerEntry
  }
  PERSONA "1" *-- "2" PersonaEntry
  ORDER_STATUS "1" *-- "3" StatusEntry
  PAYER "1" *-- "3" PayerEntry

  %% ===== 布局原语（src/components） =====
  class FullBleedHero {
    +src: string
    +variant: 'immersive' | 'functional'
    +children
    +KenBurns()
    +vignette()
  }
  class GlassCard {
    +className
    +delay: number
    +as: string
    +glow: boolean
    +entranceY24()
  }
  class FloatingPillNav {
    +tabs: TabItem[]
    +activeGlow()
    +hiddenOnAdmin()
  }
  class TabItem {
    +path: string
    +label: string
    +emoji: string
  }
  FloatingPillNav "1" *-- "4" TabItem

  %% ===== D3 组件（仅换肤） =====
  class D3CartOrb {
    +goldGradientOrb()
  }
  class D3FlipCard {
    +frontImage()
    +backGlass()
  }
  class D3StatusRing {
    +ringColors: ORDER_STATUS
  }
  class AddDishModal {
    +glassSlideUp()
  }
  class KissIcon {
    +color: love
  }

  %% ===== 视觉映射关系 =====
  PersonaEntry <.. Item : added_by → color/gradient
  PersonaEntry <.. GlassCard : glass-me / glass-partner 发丝边
  StatusEntry <.. D3StatusRing : ring colors
  StatusEntry <.. GlassCard : 状态 chip
  PayerEntry <.. GlassCard : 买单药丸描边/辉光
  FullBleedHero <.. PERSONA : hero 不绑定人格，统一暗调
  CartContext ..> PERSONA : 只读 whoAmI/added_by/split
  D3CartOrb ..> PERSONA : 金渐变
